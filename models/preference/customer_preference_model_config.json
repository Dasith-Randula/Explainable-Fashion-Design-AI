{
  "selected_model": "Category Preference",
  "selection_metric": "validation_MAP@12",
  "TOP_K": 12,
  "recent_popularity_days": 30,
  "candidate_pool_policy": "validation/test contain at least 30 negative candidates per customer when catalog permits",
